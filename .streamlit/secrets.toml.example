# Copy this file to .streamlit/secrets.toml and fill in a NEW service account
# (do not reuse the compromised "quiz-app-writer" key from the old app).
# Until this file exists, the app automatically falls back to local
# data/credentials.json + local_results/results.csv storage.

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"

[google_sheets]
spreadsheet_url = ""

# Faculty/admin dashboard login. If this section is omitted, the app falls
# back to username "admin" / password "admin123" — change this before
# sharing the app with anyone.
[admin]
username = "admin"
password = "change-me"
